<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.monitor.DmMonBizLogMapper">
    <resultMap id="autoExecJobDO" type="com.clougence.clouddm.platform.dal.model.monitor.DmMonBizLogDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="depend_on_biz_id" property="dependOnBizId"/>
        <result column="depend_on_biz_type" property="dependOnBizType"/>
        <result column="content" property="content"/>
        <result column="log_level" property="logLevel"/>
    </resultMap>

    <sql id="logDO">
        id,
        gmt_create,
        gmt_modified,
        depend_on_biz_id,
        depend_on_biz_type,
        content,
        log_level
    </sql>

    <select id="queryListByBizId" resultType="com.clougence.clouddm.platform.dal.model.monitor.DmMonBizLogDO">
        SELECT
            <include refid="logDO"/>
        FROM
            dm_mon_biz_log
        WHERE
            depend_on_biz_id = #{bizId}
    </select>

    <select id="queryListByBizIdAndType" resultMap="autoExecJobDO">
        SELECT
            <include refid="logDO"/>
        FROM
            dm_mon_biz_log
        WHERE
            depend_on_biz_id   = #{bizId}
            <!-- C8 M1 (D-1): the AND between the two predicates was missing since the initial
                 commit — every call raised a MySQL syntax error, swallowed by the never-throw
                 MASKING_NOT_BOUND observation (the dedup query never ran, so the observation
                 row never landed). Pinned by AuditRetentionTest. -->
            AND
            depend_on_biz_type = #{bizType,javaType=com.clougence.clouddm.platform.dal.model.monitor.LogDependBizType}
    </select>

    <!-- C8 M1 (design D2): retention cleanup leg of the 30-min scheduler. dm_mon_biz_log has
         NO owner column (platform-global process/forensics rows), so the delete is global by
         gmt_create; batching mirrors the sql_audit LIMIT-500 loop. -->
    <delete id="deleteBeforeDate">
        DELETE FROM
            dm_mon_biz_log
        WHERE
            #{date} <![CDATA[ > ]]> gmt_create
        LIMIT 500
    </delete>
</mapper>
