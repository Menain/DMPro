<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.govticket.DmTicketStmtRevisionMapper">

    <resultMap id="dmTicketStmtRevisionDO" type="com.clougence.clouddm.platform.dal.model.govticket.DmTicketStmtRevisionDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="ticket_id" property="ticketId"/>
        <result column="stmt_id" property="stmtId"/>
        <result column="version" property="version"/>
        <result column="sql_content" property="sqlContent"/>
        <result column="operator_uid" property="operatorUid"/>
        <result column="reason" property="reason"/>
    </resultMap>

    <sql id="dmTicketStmtRevision">
        id,
        gmt_create,
        gmt_modified,
        ticket_id,
        stmt_id,
        version,
        sql_content,
        operator_uid,
        reason
    </sql>

    <select id="queryByStmtId" resultMap="dmTicketStmtRevisionDO">
        SELECT
            <include refid="dmTicketStmtRevision"/>
        FROM
            dm_ticket_stmt_revision
        WHERE
            stmt_id = #{stmtId}
        ORDER BY
            version ASC
    </select>

    <select id="maxVersionByStmtId" resultType="java.lang.Integer">
        SELECT
            COALESCE(MAX(version), 0)
        FROM
            dm_ticket_stmt_revision
        WHERE
            stmt_id = #{stmtId}
    </select>

    <insert id="insertRevision" parameterType="com.clougence.clouddm.platform.dal.model.govticket.DmTicketStmtRevisionDO">
        INSERT INTO dm_ticket_stmt_revision
            (ticket_id, stmt_id, version, sql_content, operator_uid, reason)
        VALUES
            (#{ticketId}, #{stmtId}, #{version}, #{sqlContent}, #{operatorUid}, #{reason})
    </insert>

</mapper>
