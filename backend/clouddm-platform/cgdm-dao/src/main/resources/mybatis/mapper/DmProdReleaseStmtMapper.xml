<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.prodrelease.DmProdReleaseStmtMapper">

    <resultMap id="dmProdReleaseStmtDO" type="com.clougence.clouddm.platform.dal.model.prodrelease.DmProdReleaseStmtDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="release_id" property="releaseId"/>
        <result column="prod_ds_id" property="prodDsId"/>
        <result column="prod_db_name" property="prodDbName"/>
        <result column="seq" property="seq"/>
        <result column="sql_content" property="sqlContent"/>
        <result column="hash" property="hash"/>
        <result column="source_ticket_id" property="sourceTicketId"/>
        <result column="source_stmt_id" property="sourceStmtId"/>
        <result column="execution_key" property="executionKey"/>
        <result column="exec_status" property="execStatus"/>
        <result column="exec_detail" property="execDetail"/>
    </resultMap>

    <sql id="dmProdReleaseStmt">
        id,
        gmt_create,
        gmt_modified,
        release_id,
        prod_ds_id,
        prod_db_name,
        seq,
        sql_content,
        hash,
        source_ticket_id,
        source_stmt_id,
        execution_key,
        exec_status,
        exec_detail
    </sql>

    <select id="queryById" resultMap="dmProdReleaseStmtDO">
        SELECT
            <include refid="dmProdReleaseStmt"/>
        FROM
            dm_prod_release_stmt
        WHERE
            id = #{id}
    </select>

    <select id="queryByReleaseId" resultMap="dmProdReleaseStmtDO">
        SELECT
            <include refid="dmProdReleaseStmt"/>
        FROM
            dm_prod_release_stmt
        WHERE
            release_id = #{releaseId}
        ORDER BY
            prod_ds_id, prod_db_name, seq
    </select>

    <!-- Locking read for completion aggregation: bypasses the RR snapshot so a
         callback holding the release row lock sees every committed stmt status
         (race fix 2026-09-12). -->
    <select id="queryByReleaseIdForUpdate" resultMap="dmProdReleaseStmtDO">
        SELECT
            <include refid="dmProdReleaseStmt"/>
        FROM
            dm_prod_release_stmt
        WHERE
            release_id = #{releaseId}
        ORDER BY
            prod_ds_id, prod_db_name, seq
        FOR UPDATE
    </select>

    <select id="queryBySourceStmtId" resultMap="dmProdReleaseStmtDO">
        SELECT
            <include refid="dmProdReleaseStmt"/>
        FROM
            dm_prod_release_stmt
        WHERE
            source_stmt_id = #{sourceStmtId}
        LIMIT 1
    </select>

    <select id="nextPendingStmt" resultMap="dmProdReleaseStmtDO">
        SELECT
            <include refid="dmProdReleaseStmt"/>
        FROM
            dm_prod_release_stmt
        WHERE
            release_id = #{releaseId}
            AND prod_ds_id = #{prodDsId}
            AND prod_db_name = #{prodDbName}
            AND seq > #{afterSeq}
            AND exec_status = 'PENDING'
        ORDER BY
            seq ASC
        LIMIT 1
    </select>

    <select id="firstPendingStmt" resultMap="dmProdReleaseStmtDO">
        SELECT
            <include refid="dmProdReleaseStmt"/>
        FROM
            dm_prod_release_stmt
        WHERE
            release_id = #{releaseId}
            AND prod_ds_id = #{prodDsId}
            AND prod_db_name = #{prodDbName}
            AND exec_status = 'PENDING'
        ORDER BY
            seq ASC
        LIMIT 1
    </select>

    <update id="updateExecStatus">
        UPDATE
            dm_prod_release_stmt
        SET
            exec_status = #{execStatus},
            exec_detail = #{execDetail}
        WHERE
            id = #{id}
    </update>

    <delete id="deleteByReleaseId">
        DELETE FROM
            dm_prod_release_stmt
        WHERE
            release_id = #{releaseId}
    </delete>

</mapper>
