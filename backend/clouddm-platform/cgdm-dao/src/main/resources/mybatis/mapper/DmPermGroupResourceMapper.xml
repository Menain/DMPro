<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.permpgroup.DmPermGroupResourceMapper">
    <resultMap id="dmPermGroupResourceDO" type="com.clougence.clouddm.platform.dal.model.permpgroup.DmPermGroupResourceDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="group_id" property="groupId"/>
        <result column="auth_kind" property="authKind"
                javaType="com.clougence.clouddm.sdk.security.auth.AuthKind"/>
        <result column="res_id" property="resId"/>
        <result column="res_path" property="resPath"/>
        <result column="res_auth_label" property="authLabels"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
    </resultMap>

    <sql id="dmPermGroupResource">
        id,
        gmt_create,
        gmt_modified,
        group_id,
        auth_kind,
        res_id,
        res_path,
        res_auth_label,
        start_time,
        end_time
    </sql>

    <select id="listByGroupId" resultMap="dmPermGroupResourceDO">
        SELECT
            <include refid="dmPermGroupResource"/>
        FROM
            dm_perm_group_resource
        WHERE
            group_id = #{groupId}
    </select>

    <delete id="deleteByGroupId">
        DELETE FROM
            dm_perm_group_resource
        WHERE
            group_id = #{groupId}
    </delete>
</mapper>
