<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.dbchange.DmDbChangePromotionMapper">
    <resultMap id="dmDbChangePromotionDO" type="com.clougence.clouddm.platform.dal.model.dbchange.DmDbChangePromotionDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="promotion_code" property="promotionCode"/>
        <result column="promotion_type" property="promotionType"/>
        <result column="revision_id" property="revisionId"/>
        <result column="logical_db_id" property="logicalDbId"/>
        <result column="prod_env_id" property="prodEnvId"/>
        <result column="prod_ds_id" property="prodDsId"/>
        <result column="prod_res_path" property="prodResPath"/>
        <result column="prod_approval_id" property="prodApprovalId"/>
        <result column="execution_key" property="executionKey"/>
        <result column="gate_result" property="gateResult"/>
        <result column="preflight_result" property="preflightResult"/>
        <result column="status" property="status"/>
    </resultMap>

    <sql id="dmDbChangePromotion">
        id,
        gmt_create,
        gmt_modified,
        promotion_code,
        promotion_type,
        revision_id,
        logical_db_id,
        prod_env_id,
        prod_ds_id,
        prod_res_path,
        prod_approval_id,
        execution_key,
        gate_result,
        preflight_result,
        status
    </sql>

    <select id="queryByRevisionId" resultMap="dmDbChangePromotionDO">
        SELECT
            <include refid="dmDbChangePromotion"/>
        FROM
            dm_db_change_promotion
        WHERE
            revision_id = #{revisionId}
        LIMIT 1
    </select>

    <update id="transitStatus">
        UPDATE
            dm_db_change_promotion
        SET
            status = #{toStatus}
        WHERE
            id = #{id}
            AND status IN
            <foreach collection="expectedFrom" item="s" open="(" close=")" separator=",">
                #{s}
            </foreach>
    </update>

    <update id="updateProdApprovalId">
        UPDATE
            dm_db_change_promotion
        SET
            prod_approval_id = #{prodApprovalId}
        WHERE
            id = #{id}
    </update>

    <select id="listNonTerminal" resultMap="dmDbChangePromotionDO">
        SELECT
            <include refid="dmDbChangePromotion"/>
        FROM
            dm_db_change_promotion
        WHERE
            status NOT IN ('SUCCEEDED', 'REJECTED', 'CANCELLED')
    </select>

    <select id="listPromotionByConditionAndPage" resultMap="dmDbChangePromotionDO">
        SELECT
            p.id,
            p.gmt_create,
            p.gmt_modified,
            p.promotion_code,
            p.promotion_type,
            p.revision_id,
            p.logical_db_id,
            p.prod_env_id,
            p.prod_ds_id,
            p.prod_res_path,
            p.prod_approval_id,
            p.execution_key,
            p.gate_result,
            p.preflight_result,
            p.status
        FROM
            dm_db_change_promotion p
        INNER JOIN
            dm_logical_db l
            ON p.logical_db_id = l.id
            AND l.creator_uid = #{puid}
        <where>
            <if test="status != null and status != ''">
                AND p.status = #{status}
            </if>
            <if test="promotionType != null and promotionType != ''">
                AND p.promotion_type = #{promotionType}
            </if>
        </where>
        ORDER BY
            p.gmt_create DESC
    </select>
</mapper>
