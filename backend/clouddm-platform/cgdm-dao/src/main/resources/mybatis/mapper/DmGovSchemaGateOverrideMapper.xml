<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.prodrelease.DmGovSchemaGateOverrideMapper">

    <resultMap id="dmGovSchemaGateOverrideDO" type="com.clougence.clouddm.platform.dal.model.prodrelease.DmGovSchemaGateOverrideDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="release_id" property="releaseId"/>
        <result column="stmt_id" property="stmtId"/>
        <result column="gate_type" property="gateType"/>
        <result column="operator_uid" property="operatorUid"/>
        <result column="reason" property="reason"/>
        <result column="expire_at" property="expireAt"/>
        <result column="consumed" property="consumed"/>
        <result column="consumed_at" property="consumedAt"/>
        <result column="consumed_detail" property="consumedDetail"/>
        <result column="revoked" property="revoked"/>
        <result column="revoked_at" property="revokedAt"/>
        <result column="revoked_by" property="revokedBy"/>
        <!-- C8 M5.3 (V202610130004): the materialized expiry mark. active_key is DB-generated
             and deliberately NOT mapped (never read by the application). -->
        <result column="expired" property="expired"/>
    </resultMap>

    <sql id="dmGovSchemaGateOverride">
        id,
        gmt_create,
        gmt_modified,
        release_id,
        stmt_id,
        gate_type,
        operator_uid,
        reason,
        expire_at,
        consumed,
        consumed_at,
        consumed_detail,
        revoked,
        revoked_at,
        revoked_by,
        expired
    </sql>

    <select id="findConsumableStmtLevel" resultMap="dmGovSchemaGateOverrideDO">
        SELECT
            <include refid="dmGovSchemaGateOverride"/>
        FROM
            dm_gov_schema_gate_override
        WHERE
            release_id = #{releaseId}
            AND stmt_id = #{stmtId}
            AND gate_type = #{gateType}
            AND consumed = 0
            AND revoked = 0
            <![CDATA[ AND expire_at > #{now} ]]>
        ORDER BY
            id DESC
        LIMIT 1
    </select>

    <select id="findConsumableReleaseLevel" resultMap="dmGovSchemaGateOverrideDO">
        SELECT
            <include refid="dmGovSchemaGateOverride"/>
        FROM
            dm_gov_schema_gate_override
        WHERE
            release_id = #{releaseId}
            AND stmt_id IS NULL
            AND gate_type = #{gateType}
            AND consumed = 0
            AND revoked = 0
            <![CDATA[ AND expire_at > #{now} ]]>
        ORDER BY
            id DESC
        LIMIT 1
    </select>

    <update id="consumeCas">
        UPDATE
            dm_gov_schema_gate_override
        SET
            consumed = 1,
            consumed_at = #{consumedAt},
            consumed_detail = #{consumedDetail}
        WHERE
            id = #{id}
            AND consumed = 0
            AND revoked = 0
    </update>

    <update id="revokeCas">
        UPDATE
            dm_gov_schema_gate_override
        SET
            revoked = 1,
            revoked_at = #{revokedAt},
            revoked_by = #{revokedBy}
        WHERE
            id = #{id}
            AND consumed = 0
            AND revoked = 0
    </update>

    <select id="queryByReleaseId" resultMap="dmGovSchemaGateOverrideDO">
        SELECT
            <include refid="dmGovSchemaGateOverride"/>
        FROM
            dm_gov_schema_gate_override
        WHERE
            release_id = #{releaseId}
        ORDER BY
            id DESC
    </select>

    <!-- C8 M5.3 (V202610130004): expiry convergence feeding uk_gate_override_active — mark the
         time-expired ACTIVE rows of exactly the grant's granularity (gate_type + stmt/release
         level) so the generated active_key frees up for the legitimate re-grant. Runs INSIDE
         grant() before the insert; a no-op when nothing stale exists. -->
    <update id="expireStaleActive">
        UPDATE
            dm_gov_schema_gate_override
        SET
            expired = 1
        WHERE
            release_id = #{releaseId}
            AND gate_type = #{gateType}
            <choose>
                <when test="stmtId != null">
                    AND stmt_id = #{stmtId}
                </when>
                <otherwise>
                    AND stmt_id IS NULL
                </otherwise>
            </choose>
            AND consumed = 0
            AND revoked = 0
            AND expired = 0
            AND #{now} <![CDATA[ >= ]]> expire_at
    </update>

</mapper>
