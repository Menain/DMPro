<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.logicaldb.DmLogicalDbEnvBindingMapper">
    <resultMap id="dmLogicalDbEnvBindingDO" type="com.clougence.clouddm.platform.dal.model.logicaldb.DmLogicalDbEnvBindingDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="logical_db_id" property="logicalDbId"/>
        <result column="env_id" property="envId"/>
        <result column="ds_id" property="dsId"/>
        <result column="res_path" property="resPath"/>
    </resultMap>

    <sql id="dmLogicalDbEnvBinding">
        id,
        gmt_create,
        gmt_modified,
        logical_db_id,
        env_id,
        ds_id,
        res_path
    </sql>

    <select id="listByLogicalDbId" resultMap="dmLogicalDbEnvBindingDO">
        SELECT
            <include refid="dmLogicalDbEnvBinding"/>
        FROM
            dm_logical_db_env_binding
        WHERE
            logical_db_id = #{logicalDbId}
    </select>

    <delete id="deleteByLogicalDbId">
        DELETE FROM
            dm_logical_db_env_binding
        WHERE
            logical_db_id = #{logicalDbId}
    </delete>
</mapper>
