<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.dbchange.DmDbChangeStmtVersionMapper">
    <resultMap id="dmDbChangeStmtVersionDO" type="com.clougence.clouddm.platform.dal.model.dbchange.DmDbChangeStmtVersionDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="ticket_id" property="ticketId"/>
        <result column="stmt_index" property="stmtIndex"/>
        <result column="stmt_version" property="stmtVersion"/>
        <result column="stmt_text" property="stmtText"/>
        <result column="stmt_hash" property="stmtHash"/>
        <result column="source" property="source"/>
        <result column="fail_reason" property="failReason"/>
        <result column="operator_uid" property="operatorUid"/>
    </resultMap>

    <sql id="dmDbChangeStmtVersion">
        id,
        gmt_create,
        gmt_modified,
        ticket_id,
        stmt_index,
        stmt_version,
        stmt_text,
        stmt_hash,
        source,
        fail_reason,
        operator_uid
    </sql>

    <select id="queryByTicketId" resultMap="dmDbChangeStmtVersionDO">
        SELECT
            <include refid="dmDbChangeStmtVersion"/>
        FROM
            dm_db_change_stmt_version
        WHERE
            ticket_id = #{ticketId}
        ORDER BY
            stmt_index, stmt_version
    </select>
</mapper>
