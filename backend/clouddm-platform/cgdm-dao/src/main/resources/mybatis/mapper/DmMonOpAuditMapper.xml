<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.monitor.DmMonOpAuditMapper">
    <resultMap id="rdpOperationAuditDO" type="com.clougence.clouddm.platform.dal.model.monitor.DmMonOpAuditDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="uid" property="uid"/>
        <result column="owner_uid" property="ownerUid"/>
        <result column="user_name" property="userName"/>
        <result column="operate_date" property="operateDate"/>
        <result column="source_ip" property="sourceIp"/>
        <result column="ip" property="ip"/>
        <result column="context_in" property="contextIn"/>
        <result column="context_out" property="contextOut"/>
        <result column="resource_type" property="resourceType"
                javaType="com.clougence.clouddm.platform.dal.model.ResourceType"/>
        <result column="resource_value" property="resourceValue"/>
        <result column="resource_name" property="resourceName"/>
        <result column="security_level" property="securityLevel"
                javaType="com.clougence.clouddm.platform.dal.model.monitor.SecurityLevel"/>
        <result column="uuid_key" property="uuidKey"/>
        <result column="audit_type" property="auditType"
                javaType="com.clougence.clouddm.platform.dal.model.monitor.AuditType"/>
        <result column="operation_uri" property="operationUri"/>
        <result column="log_info" property="logInfo"/>
        <result column="log_path" property="logPath"/>
        <!-- C8 M2 audit-chain columns (V202610130003) -->
        <result column="sql_fingerprint" property="sqlFingerprint"/>
        <result column="ticket_id" property="ticketId"/>
        <result column="release_id" property="releaseId"/>
        <result column="channel" property="channel"
                javaType="com.clougence.clouddm.platform.dal.model.monitor.AuditChannel"/>
    </resultMap>

    <sql id="rdpOperationAudit">
        id
        ,
        gmt_create,
        gmt_modified,
        uid,
        owner_uid,
        user_name,
        operate_date,
        source_ip,
        ip,
        context_in,
        context_out,
        resource_type,
        resource_value,
        resource_name,
        security_level,
        audit_type,
        operation_uri,
        uuid_key,
        log_info,
        log_path,
        sql_fingerprint,
        ticket_id,
        release_id,
        channel
    </sql>

    <sql id="operationAuditCondition">
        AND owner_uid = #{puid}
        <if test="uid != null and uid != ''">
            AND uid = #{uid}
        </if>
        <if test="dateStart != null">
            <![CDATA[ AND operate_date >= #{dateStart} ]]>
        </if>
        <if test="dateEnd != null">
            <![CDATA[ AND operate_date <= #{dateEnd} ]]>
        </if>
        <if test="securityLevel != null">
            <![CDATA[ AND security_level = #{securityLevel} ]]>
        </if>
        <if test="auditType != null">
            <![CDATA[ AND audit_type = #{auditType} ]]>
        </if>
        <if test="resourceType != null">
            <![CDATA[ AND resource_type = #{resourceType} ]]>
        </if>
        <if test="userNameLike != null and userNameLike != ''">
            <![CDATA[ AND user_name LIKE CONCAT('%', #{userNameLike}, '%') ]]>
        </if>
        <!-- C8 M2 (design D4): the four audit-chain dimensions, additive optional predicates —
             with all four null the rendered SQL is byte-identical to the pre-C8 shape (pinned
             by AuditChainColumnTest). channel filters on the varchar enum name. -->
        <if test="channel != null and channel != ''">
            <![CDATA[ AND channel = #{channel} ]]>
        </if>
        <if test="ticketId != null">
            <![CDATA[ AND ticket_id = #{ticketId} ]]>
        </if>
        <if test="releaseId != null">
            <![CDATA[ AND release_id = #{releaseId} ]]>
        </if>
        <if test="sqlFingerprint != null and sqlFingerprint != ''">
            <![CDATA[ AND sql_fingerprint = #{sqlFingerprint} ]]>
        </if>
    </sql>

    <!-- C8 M1 (M1.4): the clearData dead method (still pointing at the pre-rename table
         operation_audit, zero callers repository-wide) was REMOVED. -->

    <select id="queryByConditionJoinUrlAuth" resultMap="rdpOperationAuditDO">
        SELECT
            <include refid="rdpOperationAudit"/>
        FROM
            dm_mon_op_audit
        WHERE
            1 = 1
            <if test="startId != 0">
                <![CDATA[ AND id < #{startId} ]]>
            </if>
            <if test="dateStart != null">
                <![CDATA[ AND operate_date >= #{dateStart} ]]>
            </if>
            <if test="dateEnd != null">
                <![CDATA[ AND operate_date <= #{dateEnd} ]]>
            </if>
            <if test="securityLevel != null">
                <![CDATA[ AND security_level = #{securityLevel} ]]>
            </if>
        ORDER BY id DESC
        LIMIT #{pageSize}
    </select>

    <select id="queryByUidJoinUrlAuth" resultMap="rdpOperationAuditDO">
        SELECT
            <include refid="rdpOperationAudit"/>
        FROM
            dm_mon_op_audit
        WHERE
            1 = 1
            <if test="startId != 0">
                <![CDATA[ AND id < #{startId} ]]>
            </if>
            AND
            uid = #{uid}
            <if test="dateStart != null">
                <![CDATA[ AND operate_date >= #{dateStart} ]]>
            </if>
            <if test="dateEnd != null">
                <![CDATA[ AND operate_date <= #{dateEnd} ]]>
            </if>
            <if test="securityLevel != null">
                <![CDATA[ AND security_level = #{securityLevel} ]]>
            </if>
            <if test="auditType != null">
                <![CDATA[ AND audit_type = #{auditType} ]]>
            </if>
            <if test="resourceType != null">
                <![CDATA[ AND resource_type = #{resourceType} ]]>
            </if>
        ORDER BY
            operate_date DESC, id
        LIMIT #{pageSize}
    </select>

    <select id="queryByUidsJoinUrlAuth" resultMap="rdpOperationAuditDO">
        SELECT
            <include refid="rdpOperationAudit"/>
        FROM
            dm_mon_op_audit
        WHERE
            1 = 1
            <if test="startId != 0">
                <![CDATA[ AND id < #{startId} ]]>
            </if>
            AND
            owner_uid = #{ownerUid}
            <if test="dateStart != null">
                <![CDATA[ AND operate_date >= #{dateStart} ]]>
            </if>
            <if test="dateEnd != null">
                <![CDATA[ AND operate_date <= #{dateEnd} ]]>
            </if>
            <if test="securityLevel != null">
                <![CDATA[ AND security_level = #{securityLevel} ]]>
            </if>
            <if test="auditType != null">
                <![CDATA[ AND audit_type = #{auditType} ]]>
            </if>
            <if test="resourceType != null">
                <![CDATA[ AND resource_type = #{resourceType} ]]>
            </if>
        ORDER BY
            operate_date DESC, id
        LIMIT #{pageSize}
    </select>

    <select id="querySection" resultType="com.clougence.clouddm.platform.dal.model.monitor.DmMonOpAuditDO">
        SELECT
            <include refid="rdpOperationAudit"/>
        FROM
            dm_mon_op_audit
        WHERE
            1 = 1
            <if test="startId != 0">
                <![CDATA[ AND id < #{startId} ]]>
            </if>
        ORDER BY
            operate_date DESC, id
        LIMIT #{pageSize}
    </select>

    <select id="queryByCondition" resultType="com.clougence.clouddm.platform.dal.model.monitor.DmMonOpAuditDO">
        SELECT
            <include refid="rdpOperationAudit"/>
        FROM
            dm_mon_op_audit
        WHERE
            1 = 1
            <include refid="operationAuditCondition"/>
            <if test="startId != 0">
                <![CDATA[ AND id < #{startId} ]]>
            </if>
        ORDER BY
            operate_date DESC, id
        LIMIT #{pageSize}
    </select>

    <select id="pageByCondition" resultType="com.clougence.clouddm.platform.dal.model.monitor.DmMonOpAuditDO">
        SELECT
            <include refid="rdpOperationAudit"/>
        FROM
            dm_mon_op_audit
        WHERE
            1 = 1
            <include refid="operationAuditCondition"/>
        ORDER BY
            operate_date DESC, id
        LIMIT #{pageSize}
        OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT
            COUNT(*)
        FROM
            dm_mon_op_audit
        WHERE
            1 = 1
            <include refid="operationAuditCondition"/>
    </select>

    <!-- C8 M1 (design D2): retention cleanup leg of the 30-min scheduler — the
         deleteAuditBeforeDate (dm_exec_sql_audit) shape: date predicate + LIMIT batching,
         per primary-account scope via owner_uid (tenant isolation). -->
    <delete id="deleteBeforeDate">
        DELETE FROM
            dm_mon_op_audit
        WHERE
            owner_uid = #{ownerUid}
            AND
            #{date} <![CDATA[ > ]]> operate_date
        LIMIT 500
    </delete>
</mapper>
