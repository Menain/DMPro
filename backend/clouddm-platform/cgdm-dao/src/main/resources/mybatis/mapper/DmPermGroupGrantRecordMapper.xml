<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.permpgroup.DmPermGroupGrantRecordMapper">
    <resultMap id="dmPermGroupGrantRecordDO" type="com.clougence.clouddm.platform.dal.model.permpgroup.DmPermGroupGrantRecordDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="group_id" property="groupId"/>
        <result column="group_resource_id" property="groupResourceId"/>
        <result column="member_uid" property="memberUid"/>
        <result column="auth_res_id" property="authResId"/>
    </resultMap>

    <sql id="dmPermGroupGrantRecord">
        id,
        gmt_create,
        gmt_modified,
        group_id,
        group_resource_id,
        member_uid,
        auth_res_id
    </sql>

    <select id="listByGroupId" resultMap="dmPermGroupGrantRecordDO">
        SELECT
            <include refid="dmPermGroupGrantRecord"/>
        FROM
            dm_perm_group_grant_record
        WHERE
            group_id = #{groupId}
    </select>

    <select id="listByGroupResourceId" resultMap="dmPermGroupGrantRecordDO">
        SELECT
            <include refid="dmPermGroupGrantRecord"/>
        FROM
            dm_perm_group_grant_record
        WHERE
            group_resource_id = #{groupResourceId}
    </select>

    <select id="findByGroupResourceAndMember" resultMap="dmPermGroupGrantRecordDO">
        SELECT
            <include refid="dmPermGroupGrantRecord"/>
        FROM
            dm_perm_group_grant_record
        WHERE
            group_resource_id = #{groupResourceId}
            AND
            member_uid = #{memberUid}
        LIMIT 1
    </select>

    <delete id="deleteByGroupId">
        DELETE FROM
            dm_perm_group_grant_record
        WHERE
            group_id = #{groupId}
    </delete>

    <delete id="deleteByGroupResourceId">
        DELETE FROM
            dm_perm_group_grant_record
        WHERE
            group_resource_id = #{groupResourceId}
    </delete>
</mapper>
