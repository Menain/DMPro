<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.dbpair.DmDbPairServiceMapper">
    <resultMap id="dmDbPairServiceDO" type="com.clougence.clouddm.platform.dal.model.dbpair.DmDbPairServiceDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="pair_id" property="pairId"/>
        <result column="service_id" property="serviceId"/>
    </resultMap>

    <sql id="dmDbPairService">
        id,
        gmt_create,
        gmt_modified,
        pair_id,
        service_id
    </sql>

    <select id="listByPairId" resultMap="dmDbPairServiceDO">
        SELECT
            <include refid="dmDbPairService"/>
        FROM
            dm_db_pair_service
        WHERE
            pair_id = #{pairId}
    </select>

    <delete id="deleteByPairId">
        DELETE FROM
            dm_db_pair_service
        WHERE
            pair_id = #{pairId}
    </delete>

    <select id="countByServiceId" resultType="int">
        SELECT
            COUNT(*)
        FROM
            dm_db_pair_service
        WHERE
            service_id = #{serviceId}
    </select>
</mapper>
