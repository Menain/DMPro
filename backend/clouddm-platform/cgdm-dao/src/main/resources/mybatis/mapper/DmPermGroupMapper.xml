<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clougence.clouddm.platform.dal.mapper.permpgroup.DmPermGroupMapper">
    <resultMap id="dmPermGroupDO" type="com.clougence.clouddm.platform.dal.model.permpgroup.DmPermGroupDO">
        <result column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="group_code" property="groupCode"/>
        <result column="group_name" property="groupName"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="creator_uid" property="creatorUid"/>
    </resultMap>

    <sql id="dmPermGroup">
        id,
        gmt_create,
        gmt_modified,
        group_code,
        group_name,
        description,
        status,
        creator_uid
    </sql>

    <select id="queryByGroupCode" resultMap="dmPermGroupDO">
        SELECT
            <include refid="dmPermGroup"/>
        FROM
            dm_perm_group
        WHERE
            group_code = #{groupCode}
        LIMIT 1
    </select>
</mapper>
